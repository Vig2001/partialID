{
  "plansDirectory": "quality_reports/plans",
  "env": {
    "ZOTERO_LIBRARY_ID": "5033278",
    "ZOTERO_LIBRARY_TYPE": "group"
  },
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": [
      "~/Desktop/PhD_Code.nosync",
      "~/Desktop/Stochastic_Calculus_GTA_Prep",
      "~/Desktop/FOP_Notes",
      "~/Desktop/IPL_Code.nosync",
      "~/Zotero"
    ],
    "allow": [
      "Bash(zotero-cli search *)",
      "Bash(zotero-cli get *)",
      "Bash(zotero-cli outline *)",
      "Bash(zotero-cli read *)",
      "Bash(zotero-cli notes list *)",
      "Bash(zotero-cli related *)"
    ],
    "deny": ["Read(./data/**)"],
    "ask": [
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(project1venv/bin/pip install *)",
      "Bash(project1venv/bin/python -m pip install *)",
      "Bash(dangerouslyDisableSandbox:true)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["zotero-cli *"],
    "filesystem": {
      "allowWrite": ["~/.matplotlib", "~/Library/Caches/pip"]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" }
      ]
    }
  }
}